generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                      Int                     @id @default(autoincrement())
  name                    String
  username                String                  @unique
  password                String
  roleId                  Int
  role                    Role                    @relation(fields: [roleId], references: [id])
  shifts                  Shift[]
  sales                   Sale[]                  @relation("CashierSales")
  expenses                CashierExpense[]
  approvedSales           Sale[]                  @relation("ApprovedSales")
  receivedSales           Sale[]                  @relation("RecipientCashierSales")
  cashierCategoryAccesses CashierCategoryAccess[]
  cashierInventories      CashierInventory[]      @relation("CashierInventoryOwner")
  sourcedInventories      CashierInventory[]      @relation("CashierInventorySource")
  sourcedSaleItems        SaleItem[]              @relation("SaleItemSourceCashier")
  cashierProductPrices    CashierProductPrice[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Category {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @unique
  description             String?
  products                Product[]
  cashierCategoryAccesses CashierCategoryAccess[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model CashierCategoryAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  description           String?
  imageUrl              String?
  barcode               String?                @unique
  price                 Decimal                @db.Decimal(10, 2)
  costPrice             Decimal                @db.Decimal(10, 2)
  stock                 Int                    @default(0)
  weight                Float?
  unit                  String                 @default("pcs")
  categoryId            Int
  category              Category               @relation(fields: [categoryId], references: [id])
  saleItems             SaleItem[]
  supplierPurchaseItems SupplierPurchaseItem[]
  inventoryLogs         InventoryLog[]
  cashierInventories    CashierInventory[]
  cashierProductPrices  CashierProductPrice[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model CashierInventory {
  id              Int      @id @default(autoincrement())
  cashierId       Int
  cashier         User     @relation("CashierInventoryOwner", fields: [cashierId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceCashierId Int
  sourceCashier   User     @relation("CashierInventorySource", fields: [sourceCashierId], references: [id])
  quantity        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cashierId, productId, sourceCashierId])
  @@index([cashierId, productId])
}

model CashierProductPrice {
  id        Int      @id @default(autoincrement())
  cashierId Int
  cashier   User     @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cashierId, productId])
  @@index([productId])
}

model Supplier {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  phone     String?
  notes     String?
  purchases SupplierPurchase[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model SupplierPurchase {
  id               Int                    @id @default(autoincrement())
  supplierId       Int
  supplier         Supplier               @relation(fields: [supplierId], references: [id])
  purchaseDate     DateTime
  chequeCreditDate DateTime
  referenceNumber  String?
  notes            String?
  totalAmount      Decimal                @db.Decimal(10, 2)
  items            SupplierPurchaseItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model SupplierPurchaseItem {
  id         Int              @id @default(autoincrement())
  purchaseId Int
  purchase   SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product          @relation(fields: [productId], references: [id])
  quantity   Float
  unitCost   Decimal          @db.Decimal(10, 2)
  salePrice  Decimal          @db.Decimal(10, 2)
  lineTotal  Decimal          @db.Decimal(10, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String?
  address     String?
  notes       String?
  sales       Sale[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shift {
  id                  Int       @id @default(autoincrement())
  openingCash         Decimal   @db.Decimal(10, 2)
  closingCash         Decimal?  @db.Decimal(10, 2)
  expectedClosingCash Decimal?  @db.Decimal(10, 2)
  status              String    @default("OPEN")
  notes               String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  userId              Int
  user                User      @relation(fields: [userId], references: [id])
  sales               Sale[]
  expenses            CashierExpense[]
}

model CashierExpense {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     Int?
  shift       Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(10, 2)
  description String
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, expenseDate])
  @@index([shiftId])
}

model Sale {
  id               Int        @id @default(autoincrement())
  receiptNumber    String     @unique
  userId           Int
  user             User       @relation("CashierSales", fields: [userId], references: [id])
  recipientUserId  Int?
  recipientUser    User?      @relation("RecipientCashierSales", fields: [recipientUserId], references: [id])
  customerId       Int?
  customer         Customer?  @relation(fields: [customerId], references: [id])
  shiftId          Int?
  shift            Shift?     @relation(fields: [shiftId], references: [id])
  subtotal         Decimal    @db.Decimal(10, 2)
  discountType     String?
  discountValue    Decimal?   @db.Decimal(10, 2)
  discountAmount   Decimal    @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal    @db.Decimal(10, 2)
  amountPaid       Decimal    @db.Decimal(10, 2)
  changeAmount     Decimal    @db.Decimal(10, 2)
  paymentMethod    String     @default("Cash")
  paymentReference String?
  saleType         String     @default("CUSTOMER")
  status           String     @default("completed")
  approvedByUserId Int?
  approvedBy       User?      @relation("ApprovedSales", fields: [approvedByUserId], references: [id])
  notes            String?
  isPrinted        Boolean    @default(false)
  items            SaleItem[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model SaleItem {
  id              Int      @id @default(autoincrement())
  quantity        Float
  price           Decimal  @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  saleId          Int
  sale            Sale     @relation(fields: [saleId], references: [id])
  productId       Int?
  product         Product? @relation(fields: [productId], references: [id])
  sourceCashierId Int?
  sourceCashier   User?    @relation("SaleItemSourceCashier", fields: [sourceCashierId], references: [id])
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  type      String
  quantity  Float
  note      String?
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}
