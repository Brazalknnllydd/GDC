generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id                      Int                     @id @default(autoincrement())
  name                    String
  username                String                  @unique
  password                String
  roleId                  Int
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  cashierCategoryAccesses CashierCategoryAccess[]
  approvedSales           Sale[]                  @relation("ApprovedSales")
  sales                   Sale[]                  @relation("CashierSales")
  shifts                  Shift[]
  role                    Role                    @relation(fields: [roleId], references: [id])
}

model Category {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @unique
  description             String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  cashierCategoryAccesses CashierCategoryAccess[]
  products                Product[]
}

model CashierCategoryAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  barcode       String?        @unique
  price         Decimal        @db.Decimal(10, 2)
  costPrice     Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  weight        Float?
  unit          String         @default("pcs")
  categoryId    Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
  category      Category       @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sale[]
}

model Shift {
  id                  Int       @id @default(autoincrement())
  openingCash         Decimal   @db.Decimal(10, 2)
  closingCash         Decimal?  @db.Decimal(10, 2)
  expectedClosingCash Decimal?  @db.Decimal(10, 2)
  status              String    @default("OPEN")
  notes               String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  userId              Int
  sales               Sale[]
  user                User      @relation(fields: [userId], references: [id])
}

model Sale {
  id               Int        @id @default(autoincrement())
  receiptNumber    String     @unique
  userId           Int
  customerId       Int?
  shiftId          Int?
  subtotal         Decimal    @db.Decimal(10, 2)
  discountType     String?
  discountValue    Decimal?   @db.Decimal(10, 2)
  discountAmount   Decimal    @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal    @db.Decimal(10, 2)
  amountPaid       Decimal    @db.Decimal(10, 2)
  changeAmount     Decimal    @db.Decimal(10, 2)
  paymentMethod    String     @default("Cash")
  paymentReference String?
  status           String     @default("completed")
  approvedByUserId Int?
  notes            String?
  isPrinted        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  approvedBy       User?      @relation("ApprovedSales", fields: [approvedByUserId], references: [id])
  customer         Customer?  @relation(fields: [customerId], references: [id])
  shift            Shift?     @relation(fields: [shiftId], references: [id])
  user             User       @relation("CashierSales", fields: [userId], references: [id])
  items            SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  quantity  Float
  price     Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  saleId    Int
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  type      String
  quantity  Float
  note      String?
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
